# Copy to cc.env and fill in real values. cc.env is gitignored.
# Then: chmod 600 cc.env

# Mail provider: "agentmail" (default) or "primitive".
# export CC_MAIL_PROVIDER=agentmail

# AgentMail inbox-scoped API key and the inbox to watch.
export AGENTMAIL_API_KEY=your-inbox-scoped-api-key-here
export AGENTMAIL_INBOX=you@agentmail.to

# Primitive backend only. Any local-part at your Primitive domain can receive
# mail, so PRIMITIVE_INBOX can be a readable role address such as
# taskcodex@your-domain.primitive.email.
# export CC_MAIL_PROVIDER=primitive
# export PRIMITIVE_AUTH_TOKEN=your-primitive-bearer-token
# export PRIMITIVE_INBOX=taskcodex@your-domain.primitive.email
# export PRIMITIVE_POLL_INTERVAL=15

# Which terminal to open a new Claude Code session in: "cmux" or "ghostty".
export CC_TERMINAL=cmux

# Comma-separated sender allowlist. Mail from anyone else, or that fails
# DKIM/SPF, is dropped. Keep this tight - it is the gate on who can drive
# your machine.
export CC_ALLOWED_FROM=you@example.com,your-agent@example.com

# cmux backend only: absolute path to the cmux CLI. Override if cmux is
# installed somewhere other than the default app bundle.
# export CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux

# How long (seconds) to wait for Claude's TUI to finish booting in a fresh
# surface before giving up. Heavy MCP/plugin setups cold-start past the 120s
# default; raise this if you see "ready marker not seen" bounces. If the wait
# elapses the task is NOT sent (the message stays unread and bounces back).
# export CC_READY_TIMEOUT=120
# How often (seconds) to re-check the surface for readiness during that wait.
# export CC_READY_POLL=3

# cmux backend only: required if you ran `setup_cmux.py --mode password`.
# Must match automation.socketPassword in ~/.config/cmux/cmux.json. Not needed
# for --mode allowAll. See the cmux setup section in the README.
# export CMUX_SOCKET_PASSWORD=your-cmux-socket-password

# Optional: runtime directory for prompts, attachments, and the dispatch log.
# export CC_HOME=$HOME/.agentmail-cc

# --- Lane 2: Mercury payment lane (optional) --------------------------------
# When set, the daemon also subscribes to this second inbox on the same
# websocket and routes its mail through payment_lane.py: qualify the email, and
# on a match spawn a CORTANA cmux session (identity booted via
# CLAUDE_LAUNCH_CWD=~/Cortana) that runs the "logging mercury GPO payment"
# playbook. The lane ONLY gates + spawns; all money logic lives in the playbook.
# The org-scoped AGENTMAIL_API_KEY above must be able to see this inbox. Leave
# empty to disable (upstream single-lane behavior).
#
# This value ALSO derives the direct-send recipient shape the payment gate accepts:
# cortana.h@agentmail.to admits cortana.h+<code>@agentmail.to (Mercury delivered
# straight to this inbox, To header intact), alongside the Gmail auto-forward alias
# finance+<code>@staygoldenhi.com. Boundary-anchored, so look-alikes don't qualify.
# There is no separate recipient env var — set this one and both shapes are gated.
# export CC_LANE2_INBOX=cortana.h@agentmail.to
# Repo/cwd that sets Cortana's identity for the spawned session.
# export CC_CORTANA_REPO=/Users/hayecom/Cortana
# Telegram bucket the playbook posts the write-set / escalations to.
# export CC_LANE2_TOPIC=stay_golden
# Telegram bucket for near-miss pings: a payment-SHAPED email that failed one gate
# layer (e.g. DKIM showing mercury.com on auto-forwarded mail) pings here for
# tuning instead of dying in the log. Defaults to the operator's own topic, NOT
# stay_golden. Non-payment-shaped spam stays silent.
# export CC_LANE2_NEAR_MISS_TOPIC=cortana
# Path to spawn-coder.sh (the vetted Cortana/Roland cmux spawn wrapper).
# export SPAWN_CODER=/Users/hayecom/Workspace/tools/spawn-coder/spawn-coder.sh
# Path to the Telegram gateway send CLI (referenced in the Cortana brief).
# export TG_SEND=/Users/hayecom/Workspace/tools/telegram-gateway/tg-send

# Optional: email the sender back. On a successful dispatch the daemon sends an
# immediate "working on it" ack, and the dispatched Claude session is instructed
# to send one completion reply (via cc-reply.py) when it finishes the task. Set
# to 0 to disable both (e.g. a read-only mirror that should never send mail).
# export CC_REPLY_ENABLED=1
